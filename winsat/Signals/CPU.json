{
    "跑分工具版本号": "//ProgramInfo//Version/text()",
    "命令行": "//ProgramInfo//CmdLine/text()",
    "提示": "//ProgramInfo//Note/text()",
    "跑分时间": "//SystemEnvironment/ExecDateTOD/@Friendly",
    "内存分数": "//WinSPR//MemoryScore/text()",
    "CPU分数": "//WinSPR//CpuScore/text()",
    "CPU总得分": "//WinSPR//CPUSubAggScore/text()",
    "视频编码得分": "//WinSPR//CPUSubAggScore/text()",
    "压缩速度": ["//Metrics//CPUMetrics//CompressionMetric/text()", "MB/s"],
    "加密速度": ["//Metrics//CPUMetrics//EncryptionMetric/text()", "MB/s"],
    "压缩速度2": ["//Metrics//CPUMetrics//CPUCompression2Metric/text()", "MB/s"],
    "加密速度2": ["//Metrics//CPUMetrics//Encryption2Metric/text()", "MB/s"],
    "压缩速度UP": ["//Metrics//CPUMetrics//CompressionMetricUP/text()", "MB/s"],
    "加密速度UP": ["//Metrics//CPUMetrics//EncryptionMetricUP/text()", "MB/s"],
    "压缩速度2UP": ["//Metrics//CPUMetrics//CPUCompression2MetricUP/text()", "MB/s"],
    "加密速度2UP": ["//Metrics//CPUMetrics//Encryption2Metric/text()", "MB/s"],
    "系统版本号": [["//SystemConfig//OSVersion//Major/text()", "//SystemConfig//OSVersion//Minor/text()", "//SystemConfig//OSVersion//Build/text()"], "."],
    "系统": "//SystemConfig//OSVersion//OSName/text()",
    "代号": "//SystemConfig//OSVersion//BuildLab/text()"
}