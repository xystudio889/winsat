<?xml version="1.0" encoding="utf-8"?>
<!--
    危险操作按钮（删除等）的自定义样式。

    设计要点（WinUI 3 最佳实践）：
    1. 颜色全部放进 ThemeDictionaries，用 Light / Dark / HighContrast 三套语义画刷表达，
       页面和样式里不出现任何写死的颜色，主题切换时由 {ThemeResource} 自动重新解析。
    2. 悬停 / 按下 / 禁用通过 VisualStateManager 的 CommonStates 切换，而不是用
       PointerEntered 事件或代码改 Background：
         · 深色背景：悬停提亮、按下变暗；
         · 浅色背景：悬停变暗、按下更暗；
         · 禁用：40% 不透明度的基础色（ARGB #66...），自然与背景混合。
    3. BasedOn DefaultButtonStyle 保留 WinUI 默认的字体、内边距、最小尺寸、焦点视觉等行为，
       只替换 Template 中的状态画刷，避免自己重写一套尺寸规范。
    4. 键盘焦点仍然走 UseSystemFocusVisuals；禁用态由 IsEnabled 自动驱动。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!--
            深色模式：基础色 #FF99A4，文字用黑色。
            悬停 #FFA8B1（提亮）、按下 #D9828B（变暗）、禁用 #66FF99A4（40% 不透明度）。
        -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DeleteButtonBackground" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundPointerOver" Color="#FFFFA8B1" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundPressed" Color="#FFD9828B" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundDisabled" Color="#66FF99A4" />

            <SolidColorBrush x:Key="DeleteButtonForeground" Color="#FF000000" />
            <SolidColorBrush x:Key="DeleteButtonForegroundPointerOver" Color="#FF000000" />
            <SolidColorBrush x:Key="DeleteButtonForegroundPressed" Color="#99000000" />
            <SolidColorBrush x:Key="DeleteButtonForegroundDisabled" Color="#99000000" />

            <!-- 按钮边界保持透明，避免在深色底上出现一圈突兀的描边 -->
            <SolidColorBrush x:Key="DeleteButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushDisabled" Color="Transparent" />
        </ResourceDictionary>

        <!--
            浅色模式：基础色 #C42B1C，文字用白色。
            悬停 #B12719（变暗）、按下 #A62518（更暗）、禁用 #66C42B1C（40% 不透明度）。
        -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DeleteButtonBackground" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundPointerOver" Color="#FFB12719" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundPressed" Color="#FFA62518" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundDisabled" Color="#66C42B1C" />

            <SolidColorBrush x:Key="DeleteButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DeleteButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="DeleteButtonForegroundPressed" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="DeleteButtonForegroundDisabled" Color="#99FFFFFF" />

            <SolidColorBrush x:Key="DeleteButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushDisabled" Color="Transparent" />
        </ResourceDictionary>

        <!--
            高对比度：不沿用品牌色，改用系统高对比度颜色，保证任何高对比度主题下都可辨识。
            系统颜色本身是 Color，这里包一层 SolidColorBrush 供 Background / Foreground 使用。
        -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DeleteButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DeleteButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />

            <SolidColorBrush x:Key="DeleteButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DeleteButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DeleteButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DeleteButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="DeleteButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DeleteButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style
        x:Key="DeleteButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource DeleteButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource DeleteButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DeleteButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                        ContentPresenter 既是内容宿主，也是状态切换的目标元素。
                        Control.IsTemplateFocusTarget 让系统焦点框落在正确的元素上。
                    -->
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw"
                        Control.IsTemplateFocusTarget="True">
                        <!-- 与 WinUI 默认按钮一致：状态切换时颜色做 83ms 的柔和过渡 -->
                        <ContentPresenter.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.083" />
                        </ContentPresenter.BackgroundTransition>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!-- 正常态直接使用 Style 里的 ThemeResource 画刷 -->
                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource DeleteButtonBackgroundPointerOver}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource DeleteButtonBorderBrushPointerOver}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource DeleteButtonForegroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource DeleteButtonBackgroundPressed}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource DeleteButtonBorderBrushPressed}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource DeleteButtonForegroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <!-- IsEnabled=False 时由控件模板自动进入此状态 -->
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource DeleteButtonBackgroundDisabled}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource DeleteButtonBorderBrushDisabled}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource DeleteButtonForegroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
