<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winsat.pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winsat.pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid Margin="36 0 0 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            x:Uid="SettingsTitle"
            Margin="0,40,36,36"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}" />
        <ScrollView
            Grid.Row="1"
            Padding="0,0,36,36"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Border>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" x:Uid="Personalization" Margin="0 0 0 4" />
                    <toolkit:SettingsCard x:Uid="AppTheme">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="themeMode"
                            AutomationProperties.AutomationId="themeModeComboBox"
                            SelectionChanged="ThemeMode_SelectionChanged">
                            <ComboBoxItem x:Uid="LightTheme" Tag="Light" />
                            <ComboBoxItem x:Uid="DarkTheme" Tag="Dark" />
                            <ComboBoxItem x:Uid="SystemTheme" Tag="Default" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="Background">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF1BA;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="backgroundSelector"
                            SelectionChanged="Background_SelectionChanged"
                        >
                            <ComboBoxItem Content="Mica" Tag="Mica" />
                            <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                            <ComboBoxItem Content="Arcylic" Tag="Arcylic" />
                            <ComboBoxItem Content="Arcylic Thin" Tag="ArcylicThin" />
                            <ComboBoxItem x:Uid="BackgroundNone" Content="None" Tag="None" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Header="Language" Description="Set the display language of the software.">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="languageSelector"
                            AutomationProperties.AutomationId="languageSelectorComboBox"
                            SelectionChanged="Language_SelectionChanged"
                        >
                            <ComboBoxItem Content="Use system settings" Tag="Default" />
                            <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard x:Uid="NavigationLocation">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF594;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="navigationLocation"
                            SelectionChanged="NavigationLocation_SelectionChanged">
                            <ComboBoxItem x:Uid="NavigationLeft" Tag="Left" />
                            <ComboBoxItem x:Uid="NavigationTop" Tag="Top" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsExpander x:Uid="Sound">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEC4F;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch x:Name="soundToggle" Toggled="SoundToggled" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                x:Name="SpatialAudioCard"
                                x:Uid="SpatialSound"
                                IsEnabled="False">
                                <ToggleSwitch x:Name="spatialSoundToggle" Toggled="SpatialSoundToggled" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <TextBlock Text="导入和导出" FontWeight="SemiBold" Margin="0,28,0,4" />
                    <StackPanel Spacing="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16 8 0 8">
                        <Button Content="导入跑分"/>
                        <Button Content="导出跑分" Click="ExportButton_Click" />
                    </StackPanel>

                        <!--  About  -->
                    <TextBlock x:Uid="About" FontWeight="SemiBold" Margin="0,28,0,4" />
                    <toolkit:SettingsExpander
                        x:Uid="ProductInfo">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/BadgeLogo.png" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <TextBlock
                            x:Name="versionBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Version}" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                x:Name="toCloneRepoCard"
                                x:Uid="CloneRepoHeader"
                                Click="CloneRepoCard_Click"
                                IsClickEnabled="True">
                                <TextBlock
                                    x:Name="gitCloneTextBlock"
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="git clone https://github.com/xystudio889/winsat" />
                                <toolkit:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </toolkit:SettingsCard.ActionIcon>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="bugRequestCard"
                                x:Uid="SubmitBugHeader"
                                Click="BugRequestCard_Click"
                                IsClickEnabled="True">
                                <toolkit:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </toolkit:SettingsCard.ActionIcon>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Left"
                                ContentAlignment="Vertical"
                                x:Uid="DependenciesHeader">
                                <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                    <HyperlinkButton Content="Windows APP SDK" NavigateUri="https://aka.ms/windowsappsdk" />
                                    <HyperlinkButton Content="WinUI 3" NavigateUri="https://aka.ms/winui" />
                                    <HyperlinkButton Content="Windows Community Toolkit" NavigateUri="https://github.com/CommunityToolkit/Windows" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                HorizontalContentAlignment="Left"
                                ContentAlignment="Vertical"
                                x:Uid="SourceCodeHeader">
                                <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                    <HyperlinkButton Content="Github" NavigateUri="https://github.com/xystudio889/winsat" />
                                    <HyperlinkButton x:Uid="License" Click="LicenseHyperlink_Click" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                </StackPanel>
            </Border>
        </ScrollView>
    </Grid>
</Page>
