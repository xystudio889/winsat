<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winsat.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winsat"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions >
            <!--Title Bar -->
            <RowDefinition Height = "Auto" />
            <!-- App Content -->
            <RowDefinition Height = "*" />
        </Grid.RowDefinitions >
        <!-- 主内容 -->
        <StackPanel Grid.Row = "1" Orientation = "Vertical" Margin="36 0 0 0" >
            <TextBlock 
                Grid.Row = "1" 
                FontSize = "28" 
                Text = "Windows 跑分工具" 
                Margin = "0 40 0 36"  
            />
            <!-- 主窗口 -->
            <Grid>
                <!-- 分数方框 -->
                <Canvas>
                    <Border Background="{ThemeResource AccentTextFillColorTertiaryBrush}" 
                            CornerRadius="8" 
                            Width="48" 
                            Height="48"
                            Canvas.Left="530"
                            Canvas.Top="60"
                    >
                        <TextBlock Text="无" 
                        x:Name="WinSPRLevel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Black"
                    />
                    </Border>
                </Canvas>
                <TextBlock Text="由最低子分数决定" Margin = "500 110 0 0" />
                <Line Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                      X1="-10" Y1="0"
                      X2="650" Y2="0"
                      StrokeThickness="3"  Margin = "0 0 0 0" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="组件" Margin = "0 5 0 0" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="评分的项目" Margin = "140 5 0 0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="子分数" Margin = "380 5 0 0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="基本分数" Margin = "500 5 0 0"/>
                <Line Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                      X1="-10" Y1="0"
                      X2="650" Y2="0"
                      StrokeThickness="3"  Margin = "0 30 0 0" />
                <TextBlock Grid.Row = "2" Grid.Column="0" Text = "处理器:"  FontWeight="Bold" Margin = "0 40 0 0"/>
                <TextBlock Grid.Row = "3" Grid.Column="0" Text = "游戏图形:"  FontWeight="Bold" Margin = "0 115 0 0"/>
                <TextBlock Grid.Row = "4" Grid.Column="0" Text = "主硬盘:"  FontWeight="Bold" Margin = "0 140 0 0"/>
                <TextBlock Grid.Row = "5" Grid.Column="0" Text = "图形:"  FontWeight="Bold" Margin = "0 90 0 0"/>
                <TextBlock Grid.Row = "6" Grid.Column="0" Text = "内存(RAM):" FontWeight="Bold" Margin = "0 65 0 0"/>
                <TextBlock Grid.Row = "6" Grid.Column="0" Text = "评估状态"  FontWeight="Bold" Margin = "0 165 0 0"/>
                <TextBlock Grid.Row = "2" Grid.Column="1" Text = "每秒计算速度" Margin = "140 40 0 0"/>
                <TextBlock Grid.Row = "3" Grid.Column="1" Text = "3D 商务和游戏图形性能" Margin = "140 115 0 0"/>
                <TextBlock Grid.Row = "4" Grid.Column="1" Text = "硬盘数据传输速率" Margin = "140 140 0 0"/>
                <TextBlock Grid.Row = "5" Grid.Column="1" Text = "桌面图形性能" Margin = "140 90 0 0"/>
                <TextBlock Grid.Row = "6" Grid.Column="1" Text = "每秒内存运行速度" Margin = "140 65 0 0"/>
                <TextBlock Grid.Row = "2" Grid.Column="2" Text = "(未评分)" Margin = "380 40 0 0" x:Name = "CPUScore" />
                <TextBlock Grid.Row = "3" Grid.Column="2" Text = "(未评分)" Margin = "380 115 0 0" x:Name = "D3DScore" />
                <TextBlock Grid.Row = "4" Grid.Column="2" Text = "(未评分)" Margin = "380 140 0 0" x:Name = "DiskScore" />
                <TextBlock Grid.Row = "5" Grid.Column="2" Text = "(未评分)" Margin = "380 90 0 0" x:Name = "GraphicsScore" />
                <TextBlock Grid.Row = "6" Grid.Column="2" Text = "(未评分)" Margin = "380 65 0 0" x:Name = "MemoryScore" />
                <TextBlock Grid.Row = "7" Grid.Column="2" Text = "未评分" Margin = "380 165 0 8" x:Name = "WinSATAssessmentState" />
            </Grid>
            <StackPanel Grid.Row = "1" Orientation = "Horizontal" Margin = "0 16 0 0" >
                <Button x:Name="RunScoreButton" Style = "{StaticResource AccentButtonStyle}" Content = "开始跑分" Margin = "0 0 0 0" Click="RunScore" ></Button >
                <Button Content = "加载评估结果" Margin = "8 0 0 0" Click="GetScore" ></Button >
            </StackPanel >
            <Expander Width="500" HorizontalContentAlignment="Left" Padding="0" Margin="0 16 0 0">
                <Expander.Header>
                    <TextBlock Text="高级信息" />
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Width="480" Margin="8 8 0 8" Spacing="8">
                        <TextBlock Text="请选择跑分文件：" />
                        <ComboBox x:Name="FileComboBox"
                                DisplayMemberPath="Name"
                                SelectedValuePath="FullName"
                                SelectionChanged="SelectionChanged"
                                PlaceholderText="文件不存在，请先测试"
                                Width="300"
                                HorizontalAlignment="Left" />
                        <SelectorBar x:Name="SelectorBar" SelectionChanged="SelectorBar_SelectionChanged">
                            <SelectorBarItem x:Name="Friendly" Text="友好" IsSelected="True" />
                            <SelectorBarItem x:Name="SourceCode" Text="源码" />
                        </SelectorBar>

                        <InfoBar x:Name="LoadingFileErrorBar" Severity="Error" IsOpen="False" Message="加载出现错误。">
                            <InfoBar.ActionButton>
                                <Button 
                                    Content="刷新"
                                    Click="RefreshFileButton_Click"
                                />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
                        <StackPanel Spacing="12" HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock x:Name="RefreshedFile" Visibility="Collapsed" Text="刷新完成！" Margin="0 4 0 0" />
                            <Button 
                                    x:Name="RefreshFileButton" 
                                    Content="刷新"
                                    Click="RefreshFileButton_Click"
                                />
                        </StackPanel>
                    </StackPanel>
                </Expander.Content>
            </Expander>
        </StackPanel >
        <!-- App content -->
        <Frame x:Name = "rootFrame" Grid.Row = "1" />
    </Grid>
</Page>
