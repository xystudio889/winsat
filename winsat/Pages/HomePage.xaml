<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winsat.pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winsat.pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions >
            <!--Title Bar -->
            <RowDefinition Height = "Auto" />
            <!-- App Content -->
            <RowDefinition Height = "*" />
        </Grid.RowDefinitions >
        <!-- 主内容 -->
        <StackPanel Grid.Row = "1" Orientation = "Vertical" Margin="36 0 0 0" >
            <TextBlock
                Margin="0,40,36,36"
                Style="{StaticResource TitleTextBlockStyle}"
                x:Uid="HomeTitle" />
            <TextBlock 
                Grid.Row = "1" 
                x:Uid="HomeDesc"
                Margin = "0 0 0 24"  
            />
            <InfoBar
                x:Name="WinSatTip"
                IsIconVisible="True"
                Severity="Warning"
                IsClosable="False"
                Margin="0 0 36 12"
            >
                <InfoBar.ActionButton>
                    <Button 
                        x:Name="WinsatTipButton"
                        Click="RunScore"
                        HorizontalAlignment="Right"
                    />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- 主窗口 -->
            <Grid>
                <!-- 分数方框 -->
                <Canvas x:Name="RectangleCanvas">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Left="550" Canvas.Top="50" >
                        <Border x:Name="RectangleBackground"
                            Background="{ThemeResource AccentTextFillColorTertiaryBrush}" 
                            CornerRadius="{StaticResource OverlayCornerRadius}" 
                            Width="48" 
                            Height="48">
                            <TextBlock
                                x:Name="WinSPRLevel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                FontSize="20"
                                FontWeight="Bold"
                            />
                        </Border>
                        <TextBlock x:Name="MinScoreText" x:Uid="subScoreTip" HorizontalAlignment="Center" Margin="0 78 0 0" />
                    </Grid>
                </Canvas>
                <Line Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                      X1="-10" Y1="0"
                      X2="790" Y2="0"
                      StrokeThickness="3"  Margin = "0 0 0 0" />
                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="Component" Margin = "0 8 0 0" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Uid="ScoredItems" Margin = "140 8 0 0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Uid="SubScore" Margin = "460 8 0 0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Uid="BaseScore" Margin = "590 8 0 0"/>
                <Line Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                      X1="-10" Y1="0"
                      X2="790" Y2="0"
                      StrokeThickness="3"  Margin = "0 36 0 0" />
                <TextBlock Grid.Row = "2" Grid.Column="0" x:Uid="Processor"  FontWeight="Bold" Margin = "0 45 0 0"/>
                <TextBlock Grid.Row = "3" Grid.Column="0" x:Uid="GamingGraphics"  FontWeight="Bold" Margin = "0 135 0 0"/>
                <TextBlock Grid.Row = "4" Grid.Column="0" x:Uid="PrimaryDisk"  FontWeight="Bold" Margin = "0 165 0 0"/>
                <TextBlock Grid.Row = "5" Grid.Column="0" x:Uid="Graphics"  FontWeight="Bold" Margin = "0 105 0 0"/>
                <TextBlock Grid.Row = "6" Grid.Column="0" x:Uid="MemoryRAM" FontWeight="Bold" Margin = "0 75 0 0"/>
                <TextBlock Grid.Row = "2" Grid.Column="1" x:Uid="CalcPerSecond" Margin = "140 45 0 0"/>
                <TextBlock Grid.Row = "3" Grid.Column="1" x:Uid="GamingGraphicsDesc" Margin = "140 135 0 0"/>
                <TextBlock Grid.Row = "4" Grid.Column="1" x:Uid="DiskTransferRate" Margin = "140 165 0 0"/>
                <TextBlock Grid.Row = "5" Grid.Column="1" x:Uid="DesktopGraphics" Margin = "140 105 0 0"/>
                <TextBlock Grid.Row = "6" Grid.Column="1" x:Uid="MemoryOps" Margin = "140 75 0 0"/>
                <TextBlock Grid.Row = "2" Grid.Column="2" x:Uid="NoScoredXAML" Margin = "460 45 0 0" x:Name = "CPUScore" />
                <TextBlock Grid.Row = "3" Grid.Column="2" x:Uid="NoScoredXAML" Margin = "460 135 0 0" x:Name = "D3DScore" />
                <TextBlock Grid.Row = "4" Grid.Column="2" x:Uid="NoScoredXAML" Margin = "460 165 0 0" x:Name = "DiskScore" />
                <TextBlock Grid.Row = "5" Grid.Column="2" x:Uid="NoScoredXAML" Margin = "460 105 0 0" x:Name = "GraphicsScore" />
                <TextBlock Grid.Row = "6" Grid.Column="2" x:Uid="NoScoredXAML" Margin = "460 75 0 0" x:Name = "MemoryScore" />
            </Grid>

            <StackPanel Grid.Row = "1" Orientation = "Vertical" Margin = "0 24 0 0" Spacing="5" >
                <StackPanel x:Name="LatestTip" Grid.Row = "1" Orientation = "Horizontal" Spacing="440">
                    <TextBlock x:Uid="LatestScore" ></TextBlock>
                    <HyperlinkButton x:Uid="RerunAssessment" Click="RunScore" />
                </StackPanel>
                <Grid Grid.Row = "1">
                    <TextBlock x:Name="LatestUpdateTime" Margin = "0 4 0 0" />
                    <HyperlinkButton x:Uid="ReloadAssessment" Click="GetScore" Margin="566 4 0 0" />
                </Grid>
            </StackPanel>

            <Expander Width="680" HorizontalContentAlignment="Left" Padding="0" Margin="0 16 0 0">
                <Expander.Header>
                    <TextBlock x:Uid="AdvancedInfo" />
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Width="660" Margin="8 8 0 8">
                        <TextBlock x:Uid="SelectScoreFile" />
                        <ComboBox x:Name="FileComboBox"
                                DisplayMemberPath="Name"
                                SelectedValuePath="FullName"
                                SelectionChanged="SelectionChanged"
                                x:Uid="SelectFilePlaceholder"
                                Width="400"
                                HorizontalAlignment="Left"  Margin="0 8 0 0" />
                        <SelectorBar x:Name="SelectorBar" SelectionChanged="selecterBar_SelectionChanged" Visibility="Collapsed">
                            <SelectorBarItem x:Name="Friendly" x:Uid="Visualized" IsSelected="True" />
                            <SelectorBarItem x:Name="SourceCode" x:Uid="SourceCode" />
                        </SelectorBar>

                        <InfoBar x:Name="LoadingFileErrorBar" Severity="Error" IsOpen="False"  x:Uid="LoadFileErrorTitle">
                            <InfoBar.ActionButton>
                                <Button 
                                    x:Uid="RefreshXAML"
                                    Click="RefreshFileButton_Click"
                                />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Name="LoadingSignalErrorBar" Severity="Error" x:Uid="LoadSymbolErrorTitle" />
                        <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                            <ProgressRing x:Name="LoadingRing" />
                            <TextBlock x:Uid="Loading" Margin="0 8 0 0" />
                        </StackPanel>
                        <ScrollViewer x:Name="HighlightBlockBackground" Grid.Row="3" VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto" MinHeight="100" MaxHeight="800" Width="650"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                              CornerRadius="{StaticResource ControlCornerRadius}" Margin="0 4 0 0" Visibility="Collapsed"
                        >
                            <!-- 背景和前景由代码动态设置，以适应主题 -->
                            <RichTextBlock 
                                x:Name="HighlightBlock" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                FontFamily="Consolas" FontSize="14"
                                IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                        <ScrollViewer
                            Margin="0 4 0 4"
                            Padding="0 0 0 8"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            MinHeight="200"
                            MaxHeight="1000"
                            Width="650"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            x:Name="FriendlyBackground"
                            Visibility="Collapsed"
                        >
                            <StackPanel x:Name="ValuePanel" Orientation="Vertical" Spacing="8" Margin="8 8 8 12" />


                        </ScrollViewer>
                        <StackPanel Spacing="12" HorizontalAlignment="Right" Orientation="Horizontal"  Margin="0 8 0 0" >
                            <TextBlock x:Name="LatestWarning" x:Uid="LatestFileWarning" Margin="0 8 0 0" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <Button x:Name="RemoveButton">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="&#xE74D;"
                                      Margin="0,0,8,0" />
                                    <TextBlock x:Uid="Delete" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel>
                                            <TextBlock Style="{ThemeResource BaseTextBlockStyle}" x:Uid="DeleteConfirmText" Margin="0,0,0,12" />
                                            <Button Click="DeleteFile" x:Uid="DeleteConfirmButton" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel Spacing="12" HorizontalAlignment="Right" Orientation="Horizontal"  Margin="0 8 0 0" >
                            <TextBlock x:Name="RefreshedFile" Visibility="Collapsed" x:Uid="RefreshComplete" Margin="0 8 0 0" />
                            <Button 
                                    x:Name="RefreshFileButton" 
                                    x:Uid="RefreshXAML"
                                    Click="RefreshFileButton_Click"
                                />
                        </StackPanel>
                    </StackPanel>
                </Expander.Content>
            </Expander>
        </StackPanel >
        <!-- App content -->
        <Frame x:Name = "rootFrame" Grid.Row = "1" />
    </Grid>
</Page>
