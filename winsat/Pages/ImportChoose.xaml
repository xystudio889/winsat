<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winsat.pages.ImportChoose"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winsat.pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Stretch">
        <StackPanel x:Name="SelectImport" Spacing="16">
            <TextBlock x:Uid="ImportFileTip" />
            <!-- 输入框占满剩余宽度，导入（选择文件）按钮保持自身大小，中间 4px 空隙 -->
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImportPathBox" x:Uid="ImportPathBox" TextChanged="ImportPathBox_TextChanged" />
                <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click">
                    <FontIcon Glyph="&#xE8A5;" />
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="ImportButton"
                        x:Uid="ImportStartButton"
                        Click="ImportButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
        <!-- 与导出页一致的“正在工作”提示 -->
        <StackPanel x:Name="ImportWorkingBar" Orientation="Horizontal" Margin="0 16 0 0" Spacing="16" Visibility="Collapsed">
            <ProgressRing x:Name="ImportWorkingRing" />
            <TextBlock x:Uid="Working" />
        </StackPanel>
        <StackPanel x:Name="ImportEnd" Spacing="4" Margin="0 16 0 0" Visibility="Collapsed">
            <InfoBar x:Name="ImportSuccessBar" Severity="Success" IsOpen="False" x:Uid="ImportSuccessBarTitle" IsClosable="False" />
            <InfoBar x:Name="ImportWarningBar" Severity="Warning" IsOpen="False" x:Uid="ImportWarningBarTitle" IsClosable="False" />
            <InfoBar x:Name="ImportErrorBar" Severity="Error" IsOpen="False" x:Uid="ImportErrorBarTitle" IsClosable="False" />
        </StackPanel>
    </StackPanel>
</Page>
