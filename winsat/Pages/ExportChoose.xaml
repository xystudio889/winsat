<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="winsat.pages.ExportChoose"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:winsat.pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <StackPanel x:Name="SelectExport" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Spacing="16" Visibility="Visible">
            <StackPanel Orientation="Vertical" Spacing="4" >
                <Button Style="{StaticResource SubtleButtonStyle}" Click="WSTExportShow">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Glyph="&#xE7B8;" />
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock x:Uid="ExportWSTTitle" Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="16" />
                            <TextBlock x:Uid="ExportWSTDesc" Grid.Row="0" Grid.Column="1" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}" Click="HTMLExportShow">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE8A1;" />
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock x:Uid="ExportHTMLTitle" Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="16" />
                            <TextBlock x:Uid="ExportHTMLDesc" Grid.Row="0" Grid.Column="1" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="WSTExport" Spacing="4" Visibility="Collapsed">
            <TextBlock x:Uid="SelectExportFile" />
            <Grid x:Name="WSTBar" Margin="0 4 0 0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 三个事件都要接：WinUI 三态循环是 未选中 -> 已选中 -> 不确定，
                     少接一个就会有状态点不动（如去掉 Indeterminate 时“全选”会变成“半选”） -->
                <CheckBox x:Name="OptionsAllCheckBox" x:Uid="SelectAllOptions"
                          IsThreeState="True"
                          Checked="SelectAll_Checked"
                          Unchecked="SelectAll_Unchecked"
                          Indeterminate="SelectAll_Indeterminate" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8 0 8 0" Margin="8 0 8 0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Height="380" CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel x:Name="ExportFileContent" Padding="0 4 0 4" />
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Stretch" Margin="0 8 0 0">
                <StackPanel HorizontalAlignment="Right" Margin="0 4 0 0" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="WSTRefreshComplete" x:Uid="RefreshComplete" Visibility="Collapsed" Margin="0 6 0 0" />
                    <Button x:Uid="RefreshXAML" Click="RefreshWstFileButton_Click"  />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="HTMLExport" Spacing="4" Visibility="Collapsed" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="SelectScoreFile" />
            <ComboBox x:Name="FileComboBox"
                DisplayMemberPath="Name"
                SelectedValuePath="FullName"
                x:Uid="SelectFilePlaceholder"
                Width="400"
                HorizontalAlignment="Left"  Margin="0 8 0 0" SelectionChanged="SelectionChanged" />

            <InfoBar x:Name="LoadingFileErrorBar" Severity="Error" IsOpen="False"  x:Uid="LoadFileErrorTitle">
                <InfoBar.ActionButton>
                    <Button 
                x:Uid="RefreshXAML"
                Click="RefreshFileButton_Click"
            />
                </InfoBar.ActionButton>
            </InfoBar>
            <Grid x:Name="BottomBar"  Margin="0 8 0 0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="EasyViewCheckbox" x:Uid="EasyViewCheckbox" IsChecked="True" />
                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock x:Name="RefreshComplete" x:Uid="RefreshComplete" Margin="0 6 0 0" Visibility="Collapsed" />
                    <Button x:Uid="RefreshXAML" Click="RefreshFileButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <!-- HTML 与包模式共用的“正在工作”提示 -->
        <StackPanel x:Name="WorkingBar" Orientation="Horizontal"  Margin="0 8 0 0" Visibility="Collapsed" Spacing="16">
            <ProgressRing x:Name="WorkingRing" />
            <TextBlock x:Uid="Working" />
        </StackPanel>
        <StackPanel x:Name="ControlBar" Spacing="12" Orientation="Horizontal"  Margin="280 16 0 0" Visibility="Collapsed" HorizontalAlignment="Right" >
            <Button x:Uid="PrevStep" Click="OnPrevPage" />
            <Button x:Name="ExportButton" x:Uid="ExportButton" Click="ExportFileButton_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <StackPanel x:Name="ExportEnd" HorizontalAlignment="Stretch" Spacing="4">
            <InfoBar x:Name="ExportSuccessBar" Severity="Success" IsOpen="False"  x:Uid="ExportSuccessBarTitle" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button 
                        x:Uid="OpenExportFileButton"
                        Click="ExportSuccessFileButton_Click"
                    />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ExportWarningBar" Severity="Warning" IsOpen="False"  x:Uid="ExportWarningBarTitle" IsClosable="False" />
            <InfoBar x:Name="ExportErrorBar" Severity="Error" IsOpen="False"  x:Uid="ExportFileErrorXAML" IsClosable="False" />
        </StackPanel>
    </StackPanel>
</Page>
